# Leave both empty for local development: Vite proxies /api and /socket.io to
# the API on :4000, so auth cookies stay same-origin.

# Only set if the browser must call the API on another origin (not recommended;
# the Vercel config rewrites /api to the API instead, keeping cookies first-party).
VITE_API_URL=

# Production on Vercel: Vercel cannot proxy WebSockets, so live updates connect
# straight to the API service, e.g. https://libraverse-api.onrender.com
VITE_SOCKET_URL=
