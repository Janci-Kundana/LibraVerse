# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/libraverse for a local server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/libraverse
# Origin of the React app, used for CORS and links in emails
CLIENT_URL=http://localhost:5173
# Public URL of this API, used in the Razorpay webhook URL shown to library admins.
# Leave empty in development (the React dev server proxies /api). For webhooks to reach
# your laptop, use a tunnel (e.g. ngrok) and put its https URL here.
PUBLIC_API_URL=

# JWT signing secrets: two different random strings, at least 32 characters each.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs member card QR codes; changing it invalidates every printed/displayed card QR.
CARD_QR_SECRET=
# Encrypts each library's Razorpay key secret and webhook secret at rest (AES-256-GCM).
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored Razorpay secrets unreadable; libraries would have to re-enter them.
ENCRYPTION_KEY=
# Background jobs: due/overdue/expiry reminders, reservation hold expiry.
CRON_ENABLED=true

# Email (SMTP). Leave SMTP_HOST empty in development to print emails, OTPs and
# set-password links to the server console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LibraVerse <no-reply@libraverse.local>

# File storage (logos, covers, ID proofs). Leave CLOUDINARY_URL empty in development
# to store files in UPLOAD_DIR on disk. ID proofs are always private.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
UPLOAD_DIR=uploads

# Web Push notifications (optional). Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@libraverse.local

# The platform's own Razorpay account (test mode) for Pro subscriptions (optional).
# Webhook URL: <PUBLIC_API_URL>/api/webhooks/razorpay/platform
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# AI library assistant (optional). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Google sign-in (optional). OAuth 2.0 web client id; add http://localhost:5173 as an
# authorised JavaScript origin in Google Cloud Console.
GOOGLE_CLIENT_ID=
